# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For local MongoDB (uncomment if MongoDB is running locally)
MONGODB_URI=mongodb://127.0.0.1:27017/appointment-hub

# For MongoDB Atlas (uncomment and replace with your connection string)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/appointment-hub?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# CORS Configuration
FRONTEND_URL=http://localhost:3000 